<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.linuxlab.testime"
    android:versionCode="1"
    android:versionName="1">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />

    <application android:allowBackup="false" android:label="Linux Lab test keyboard">
        <service
            android:name=".TestIme"
            android:exported="true"
            android:label="Linux Lab test keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
